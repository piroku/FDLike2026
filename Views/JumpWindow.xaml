<Window x:Class="FDLike2026.Views.JumpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JumpFolder" Width="900" Height="640" MinWidth="600" MinHeight="400"
        TextOptions.TextFormattingMode="{DynamicResource TextFormattingMode}"
        TextOptions.TextRenderingMode="{DynamicResource TextRenderingMode}"
        RenderOptions.ClearTypeHint="Enabled"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource BaseFontSize}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- WinFM と同じく、選択行は黄色の帯に黒文字 -->
        <Style x:Key="JumpItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelBgBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelFgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="4">
        <!-- 1 回だけのジャンプ: パスを貼り付けて Enter（Teams 等から送られた共有フォルダ用） -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Frame}" Margin="0,0,0,4">
            <Grid Margin="6,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" Text="パス:"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="PathBox" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource BaseFontSize}"
                         Background="#FF000040" Foreground="White" CaretBrush="White" BorderBrush="{DynamicResource FrameBrush}" Padding="4,2"
                         HorizontalAlignment="Stretch"
                         ToolTip="\\server\share\folder、file://server/share/…、&quot;…&quot; で囲まれたもの、%20 入り、ファイルのパス（そのフォルダへ移動してファイルにカーソル）を受け付けます"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Mono}" Foreground="{DynamicResource DimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"
                           Text="Teams 等から送られたパスを貼り付けて Enter: 登録せずに 1 回だけ移動（\\server\share、file://…、&quot;…&quot; 付き、ファイルのパスも可）　　Tab / Ctrl+V: この欄へ（Ctrl+V は通れば即移動）"/>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Frame}">
            <TextBlock Style="{StaticResource Mono}" Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap"
                       Text="A～Z / F1～F12 キー: その場所へジャンプ　　クリック: 選択　　ダブルクリック / Enter: 選択行へジャンプ　　右クリック: メニュー　　Space / Ins: 選択行に現在のディレクトリを登録（未登録キーを押しても登録）　　Shift+E: パスを編集　　Del: 登録解除　　上のパス欄: 貼り付けて Enter で 1 回だけ移動　　Esc: 閉じる"/>
        </Border>
        <Border Style="{StaticResource Frame}">
            <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Focusable="False" Foreground="{DynamicResource TextBrush}"
                     ItemContainerStyle="{StaticResource JumpItem}"
                     KeyboardNavigation.DirectionalNavigation="None"
                     MouseDoubleClick="List_MouseDoubleClick"
                     PreviewMouseLeftButtonDown="List_MouseLeftDown"
                     PreviewMouseLeftButtonUp="List_MouseLeftUp"
                     PreviewMouseRightButtonDown="List_MouseRightDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="ここへジャンプ(_J)" Click="Menu_Jump"/>
                        <Separator/>
                        <MenuItem Header="現在のディレクトリを登録(_R)　Ins" Click="Menu_Register"/>
                        <MenuItem Header="パスを編集(_E)　Shift+E" Click="Menu_Edit"/>
                        <MenuItem Header="登録解除(_D)　Del" Click="Menu_Delete"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock TextAlignment="Right" VerticalAlignment="Center">
                                <Run Text="{Binding Label, Mode=OneWay}"/><Run Text=" :"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Path, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
