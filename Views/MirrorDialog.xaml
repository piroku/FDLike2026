<Window x:Class="FDLike2026.Views.MirrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ミラーコピー" Width="760" SizeToContent="Height" ResizeMode="NoResize"
        TextOptions.TextFormattingMode="{DynamicResource TextFormattingMode}"
        TextOptions.TextRenderingMode="{DynamicResource TextRenderingMode}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource OtherBgBrush}" FontFamily="{DynamicResource OtherFontFamily}" FontSize="{DynamicResource OtherFontSize}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InfoItemBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource InfoTitleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource InfoItemBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource Frame}" Margin="8">
        <StackPanel Margin="10">
            <DockPanel Margin="0,0,0,4">
                <Label Content="登録手順(_P):" DockPanel.Dock="Left" Margin="0,0,8,0" Target="{Binding ElementName=ProcCombo}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="名前を付けて保存" Click="SaveProc_Click"/>
                    <Button Content="削除" Click="DeleteProc_Click" Margin="0"/>
                </StackPanel>
            </DockPanel>
            <ComboBox x:Name="ProcCombo" Foreground="Black" Margin="0,0,0,10" SelectionChanged="Proc_Changed"/>

            <DockPanel Margin="0,0,0,4">
                <Label Content="複写元フォルダ(_S):" DockPanel.Dock="Left" Target="{Binding ElementName=SrcBox}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="カレント" Click="SrcCurrent_Click"/>
                    <Button Content="参照..." Click="SrcBrowse_Click" Margin="0"/>
                </StackPanel>
            </DockPanel>
            <TextBox x:Name="SrcBox" Margin="0,0,0,8"/>
            <DockPanel Margin="0,0,0,4">
                <Label Content="複写先フォルダ(_D):" DockPanel.Dock="Left" Target="{Binding ElementName=DstBox}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="反対側" Click="DstOther_Click"/>
                    <Button Content="ジャンプ..." Click="DstJump_Click"/>
                    <Button Content="参照..." Click="DstBrowse_Click" Margin="0"/>
                </StackPanel>
            </DockPanel>
            <TextBox x:Name="DstBox" Margin="0,0,0,10"/>

            <GroupBox Header="フィルタ（ワイルドカード、スペース区切りで複数）">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="検索対象:" Margin="0,0,8,4"/>
                    <TextBox Grid.Column="1" x:Name="IncludeBox" Text="*.*" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" Text="検索除外（ファイル）:" Margin="0,0,8,4"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="ExcludeBox" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="2" Text="検索除外（フォルダ）:" Margin="0,0,8,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="ExcludeDirBox"/>
                </Grid>
            </GroupBox>
            <GroupBox Header="オプション">
                <StackPanel>
                    <CheckBox x:Name="ConfirmCheck" Content="処理実行前に内容を確認する（更新・削除されるファイルの一覧を表示してから実行）" IsChecked="True"/>
                    <CheckBox x:Name="DeleteCheck" Content="複写元に無いファイルを複写先から削除する（本来のミラー。外すと更新のみ）" IsChecked="True"/>
                    <CheckBox x:Name="HiddenCheck" Content="隠し / システム属性のファイルも対象にする" IsChecked="True"/>
                    <TextBlock Foreground="{DynamicResource OtherDimBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Windows 標準の robocopy を使います。削除はごみ箱を経由しません。"/>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="実行 (Enter)" Click="Ok_Click" IsDefault="True"/>
                <Button Content="キャンセル (Esc)" Click="Cancel_Click" IsCancel="True" Margin="0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
