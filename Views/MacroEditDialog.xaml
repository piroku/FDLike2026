<Window x:Class="FDLike2026.Views.MacroEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="マクロの設定" Width="760" Height="560" MinWidth="560" MinHeight="400"
        TextOptions.TextFormattingMode="{DynamicResource TextFormattingMode}"
        TextOptions.TextRenderingMode="{DynamicResource TextRenderingMode}"
        RenderOptions.ClearTypeHint="Enabled"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource OtherBgBrush}" FontFamily="{DynamicResource OtherFontFamily}" FontSize="{DynamicResource OtherFontSize}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MinWidth" Value="96"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- タイトル(T) -->
        <Label Grid.Row="0" Grid.Column="0" Content="タイトル(_T)" Target="{Binding ElementName=TitleBox}" Margin="0,0,10,8"/>
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TitleBox" Margin="0,0,0,8"/>

        <!-- マクロ(M) + 参照(R)... -->
        <Label Grid.Row="1" Grid.Column="0" Content="マクロ(_M)" Target="{Binding ElementName=MacroBox}" Margin="0,0,10,8"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="MacroBox" Margin="0,0,8,8"/>
        <Button Grid.Row="1" Grid.Column="2" Content="参照(_R)..." Click="Browse_Click" Margin="0,0,0,8"/>

        <!-- $ マクロの説明（スクロール） -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Frame}" Margin="0,2,0,10">
            <ScrollViewer x:Name="HelpScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <TextBlock x:Name="HelpText" Margin="8,6" TextWrapping="Wrap" Foreground="{DynamicResource OtherFgBrush}"
                           FontFamily="{DynamicResource OtherFontFamily}" FontSize="{DynamicResource OtherFontSize}"/>
            </ScrollViewer>
        </Border>

        <!-- OK / キャンセル -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Click="Ok_Click" IsDefault="True" Margin="0,0,8,0"/>
            <Button Content="キャンセル" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
