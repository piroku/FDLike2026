<Window x:Class="FDLike2026.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="カスタマイズ" Width="880" SizeToContent="Height" ResizeMode="NoResize"
        TextOptions.TextFormattingMode="{DynamicResource TextFormattingMode}"
        TextOptions.TextRenderingMode="{DynamicResource TextRenderingMode}"
        RenderOptions.ClearTypeHint="Enabled"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource OtherBgBrush}" FontFamily="{DynamicResource OtherFontFamily}" FontSize="{DynamicResource OtherFontSize}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource InfoTitleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="255"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="16"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,3"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="8" TextElement.Foreground="{DynamicResource OtherFgBrush}">
        <!-- 下: OK / キャンセル -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock Foreground="{DynamicResource OtherDimBrush}" VerticalAlignment="Center" Margin="0,0,16,0"
                       Text="変更は即座に画面へ反映されます。キャンセルで元に戻ります。"/>
            <Button Content="OK" Width="110" Click="Ok_Click" IsDefault="True"/>
            <Button Content="キャンセル" Width="110" Click="Cancel_Click" IsCancel="True" Margin="0"/>
        </StackPanel>

        <TabControl x:Name="Tabs" Background="Transparent" BorderBrush="{DynamicResource FrameBrush}">
            <!-- ================= デザイン ================= -->
            <TabItem Header="デザイン">
                <StackPanel Margin="8">
                    <GroupBox Header="カラー">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 配色(S) -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="配色(S):" Foreground="{DynamicResource InfoItemBrush}" Margin="0,0,0,4"/>
                            <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="削除" Click="SchemeDelete_Click" Margin="0"/>
                                <Button DockPanel.Dock="Right" Content="名前を付けて保存..." Click="SchemeSave_Click"/>
                                <ComboBox x:Name="SchemeCombo" SelectionChanged="Scheme_Changed" Margin="0,0,8,0"/>
                            </DockPanel>

                            <!-- 指定する部分(P) -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="指定する部分(P):" Foreground="{DynamicResource InfoItemBrush}" Margin="0,0,0,4"/>
                                <ListBox x:Name="PartList" Height="300" Background="#40000000" BorderBrush="{DynamicResource FrameBrush}"
                                         Foreground="{DynamicResource OtherFgBrush}" SelectionChanged="Part_Changed"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource SelBgColor}"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource SelFgColor}"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource SelBgColor}"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource SelFgColor}"/>
                                    </ListBox.Resources>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                <Border Width="22" Height="14" BorderBrush="{DynamicResource OtherFgBrush}" BorderThickness="1"
                                                        Background="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- 右: 色の選択 / RGB / サンプル -->
                            <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Content="色の選択(C)..." Click="PickColor_Click"/>
                                    <Button Content="既定に戻す" Click="ResetPart_Click" Margin="0"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="R:" Foreground="{DynamicResource InfoItemBrush}" Margin="0,0,6,0"/>
                                    <TextBox  Grid.Row="0" Grid.Column="1" x:Name="RBox" TextAlignment="Right" LostFocus="Rgb_TextChanged" KeyDown="Rgb_KeyDown"/>
                                    <Slider   Grid.Row="0" Grid.Column="2" x:Name="RSlider" ValueChanged="Rgb_SliderChanged"/>
                                    <TextBlock Grid.Row="1" Text="G:" Foreground="{DynamicResource InfoItemBrush}" Margin="0,0,6,0"/>
                                    <TextBox  Grid.Row="1" Grid.Column="1" x:Name="GBox" TextAlignment="Right" LostFocus="Rgb_TextChanged" KeyDown="Rgb_KeyDown"/>
                                    <Slider   Grid.Row="1" Grid.Column="2" x:Name="GSlider" ValueChanged="Rgb_SliderChanged"/>
                                    <TextBlock Grid.Row="2" Text="B:" Foreground="{DynamicResource InfoItemBrush}" Margin="0,0,6,0"/>
                                    <TextBox  Grid.Row="2" Grid.Column="1" x:Name="BBox" TextAlignment="Right" LostFocus="Rgb_TextChanged" KeyDown="Rgb_KeyDown"/>
                                    <Slider   Grid.Row="2" Grid.Column="2" x:Name="BSlider" ValueChanged="Rgb_SliderChanged"/>
                                </Grid>
                                <TextBlock Text="カラーサンプル" Foreground="{DynamicResource InfoItemBrush}" Margin="0,0,0,4"/>
                                <Border x:Name="Sample" Height="48" BorderBrush="{DynamicResource OtherFgBrush}" BorderThickness="1" Margin="0,0,0,8"/>
                                <DockPanel>
                                    <TextBlock Text="#RRGGBB:" Foreground="{DynamicResource InfoItemBrush}" Margin="0,0,6,0"/>
                                    <TextBox x:Name="HexBox" LostFocus="Hex_Changed" KeyDown="Hex_KeyDown"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="フォント" Margin="0,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Content="情報ボックス(I)..." Click="Font_Click" Tag="Info" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InfoFontText" Foreground="{DynamicResource OtherDimBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Row="1" Content="ファイル一覧(L)..." Click="Font_Click" Tag="List" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ListFontText" Foreground="{DynamicResource OtherDimBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Row="2" Content="ツリー(T)..." Click="Font_Click" Tag="Tree" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TreeFontText" Foreground="{DynamicResource OtherDimBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Row="3" Content="その他(W)..." Click="Font_Click" Tag="Other" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="OtherFontText" Foreground="{DynamicResource OtherDimBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                <!-- 行間: 一覧 / ツリー / ビューア（Grid で列をそろえる） -->
                                <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="行間ギャップ(A)  一覧　　:" Foreground="{DynamicResource InfoItemBrush}" VerticalAlignment="Center" Margin="0,2"/>
                                    <TextBox  Grid.Row="0" Grid.Column="1" x:Name="GapBox" Width="44" TextAlignment="Right" LostFocus="Gap_Changed" KeyDown="Gap_KeyDown" Margin="0,2"/>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="2,0,4,0" VerticalAlignment="Center">
                                        <Button Content="▲" Padding="4,-2" FontSize="9" Height="12" Margin="0" Click="GapUp_Click"/>
                                        <Button Content="▼" Padding="4,-2" FontSize="9" Height="12" Margin="0" Click="GapDown_Click"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="ドット" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="行間ギャップ(B)  ツリー　:" Foreground="{DynamicResource InfoItemBrush}" VerticalAlignment="Center" Margin="0,2"/>
                                    <TextBox  Grid.Row="1" Grid.Column="1" x:Name="TreeGapBox" Width="44" TextAlignment="Right" LostFocus="TreeGap_Changed" KeyDown="TreeGap_KeyDown" Margin="0,2"/>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="2,0,4,0" VerticalAlignment="Center">
                                        <Button Content="▲" Padding="4,-2" FontSize="9" Height="12" Margin="0" Click="TreeGapUp_Click"/>
                                        <Button Content="▼" Padding="4,-2" FontSize="9" Height="12" Margin="0" Click="TreeGapDown_Click"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="ドット" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="行間ギャップ(C)  ビューア:" Foreground="{DynamicResource InfoItemBrush}" VerticalAlignment="Center" Margin="0,2"/>
                                    <TextBox  Grid.Row="2" Grid.Column="1" x:Name="ViewerGapBox" Width="44" TextAlignment="Right" LostFocus="ViewerGap_Changed" KeyDown="ViewerGap_KeyDown" Margin="0,2"/>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="2,0,4,0" VerticalAlignment="Center">
                                        <Button Content="▲" Padding="4,-2" FontSize="9" Height="12" Margin="0" Click="ViewerGapUp_Click"/>
                                        <Button Content="▼" Padding="4,-2" FontSize="9" Height="12" Margin="0" Click="ViewerGapDown_Click"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="ドット" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </GroupBox>
                        <StackPanel Grid.Column="1">
                            <GroupBox Header="タグマーク">
                                <StackPanel>
                                    <RadioButton x:Name="TagArrow" Content="矢印(Y)  ▶" Checked="TagMark_Changed"/>
                                    <RadioButton x:Name="TagStar"  Content="＊印(X)  *" Checked="TagMark_Changed"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="文字の描画">
                                <StackPanel>
                                    <RadioButton x:Name="RenderClearType" Content="ClearType（なめらか）" Checked="Render_Changed"/>
                                    <RadioButton x:Name="RenderGray"      Content="グレースケール" Checked="Render_Changed"/>
                                    <RadioButton x:Name="RenderAliased"   Content="アンチエイリアスなし（WinFM 風にくっきり）" Checked="Render_Changed"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- ================= リスト（WinFM2008 カスタマイズ › リスト） ================= -->
            <TabItem Header="リスト">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左: 表示モードとキー割り当て / 起動時のモード / フォルダの表記 -->
                    <StackPanel Grid.Column="0">
                        <GroupBox Header="表示モードとキー割り当て">
                            <StackPanel>
                                <ListBox x:Name="ModeList" Height="130" Background="#40000000" BorderBrush="{DynamicResource FrameBrush}"
                                         Foreground="{DynamicResource OtherFgBrush}" SelectionChanged="Mode_Changed">
                                    <ListBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource SelBgColor}"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource SelFgColor}"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource SelBgColor}"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource SelFgColor}"/>
                                    </ListBox.Resources>
                                </ListBox>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="名前:" Foreground="{DynamicResource InfoItemBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="ModeNameBox" TextChanged="ModeName_Changed"/>
                                </DockPanel>
                                <CheckBox x:Name="RightPaneCheck" Content="右ウィンドウを表示する (Shift+F6)" Margin="0,8,0,0" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                <CheckBox x:Name="GitCheck" Content="git の状態を表示する (M/U/A/D/!/●)" Margin="0,4,0,0" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                <TextBlock Foreground="{DynamicResource OtherDimBrush}" TextWrapping="Wrap"
                                           Text="右ウィンドウ OFF で左の一覧だけになります（右クリックからも切替可）。"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="起動時のモード">
                            <ComboBox x:Name="StartupModeCombo"/>
                        </GroupBox>
                        <GroupBox Header="フォルダの表記">
                            <ComboBox x:Name="DirLabelCombo" IsEditable="True">
                                <ComboBoxItem Content="&lt; DIR &gt;"/>
                                <ComboBoxItem Content="&lt;DIR&gt;"/>
                                <ComboBoxItem Content="[DIR]"/>
                                <ComboBoxItem Content="&lt;フォルダ&gt;"/>
                            </ComboBox>
                        </GroupBox>
                        <CheckBox x:Name="OverflowCheck" Content="表示しきれない部分列も表示する(R)" Checked="Field_Changed" Unchecked="Field_Changed"/>
                    </StackPanel>

                    <!-- 右: 選択中モードの内容 -->
                    <StackPanel Grid.Column="2">
                        <GroupBox Header="ファイル名">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="NameFixed" GroupName="NameMode" Content="文字数指定(N)" Checked="Field_Changed"/>
                                    <TextBox x:Name="NameCharsBox" Width="48" TextAlignment="Right" Margin="8,0,4,0" TextChanged="Field_Changed"/>
                                    <TextBlock Text="文字" VerticalAlignment="Center"/>
                                </StackPanel>
                                <RadioButton x:Name="NameDos" GroupName="NameMode"  Content="MS-DOS 形式(8.3)(M)" Checked="Field_Changed"/>
                                <RadioButton x:Name="NameAuto" GroupName="NameMode" Content="文字数自動(A)　※一覧内の最長の名前・拡張子に合わせる" Checked="Field_Changed"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="拡張子">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="SplitExtCheck" Content="分離する(E)" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                    <TextBlock Text="　文字数(X):" VerticalAlignment="Center"/>
                                    <TextBox x:Name="ExtCharsBox" Width="48" TextAlignment="Right" Margin="4,0,4,0" TextChanged="Field_Changed"/>
                                    <TextBlock Text="文字" VerticalAlignment="Center"/>
                                </StackPanel>
                                <CheckBox x:Name="DirNoSplitCheck" Content="フォルダは分離しない(F)" Checked="Field_Changed" Unchecked="Field_Changed"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="日付と時刻">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                        <TextBlock Text="種類(K):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="DateKindCombo" Width="110" SelectionChanged="Field_Changed">
                                            <ComboBoxItem Content="更新日時"/>
                                            <ComboBoxItem Content="作成日時"/>
                                            <ComboBoxItem Content="アクセス日時"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <CheckBox x:Name="ShowDateCheck" Content="日付を表示(D)" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                        <RadioButton x:Name="Year4" GroupName="YearMode" Content="西暦4桁(4)" Checked="Field_Changed"/>
                                        <RadioButton x:Name="Year2" GroupName="YearMode" Content="西暦2桁(2)" Margin="10,2,0,2" Checked="Field_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <CheckBox x:Name="ShowTimeCheck" Content="時刻を表示(T)" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                    <CheckBox x:Name="SecondsCheck" Content="秒まで表示(S)" Margin="20,0,0,4" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="左余白文字数(L):" VerticalAlignment="Center"/>
                                        <TextBox x:Name="DatePadBox" Width="40" TextAlignment="Right" Margin="4,0,0,0" TextChanged="Field_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <GroupBox Header="ファイルサイズ" Margin="0,0,8,8">
                                <StackPanel>
                                    <CheckBox x:Name="ShowSizeCheck" Content="ファイルサイズを表示(Z)" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                    <CheckBox x:Name="SizeShortCheck" Content="簡略表示(B)  例: 1.2MB" Margin="20,0,0,4" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Grid.Column="1" Header="ファイル属性">
                                <StackPanel>
                                    <CheckBox x:Name="ShowAttrCheck" Content="ファイル属性を表示(R)" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                    <CheckBox x:Name="AttrFilmtnCheck" Content="FILMTN 準拠表示(I)" Margin="20,0,0,4" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                </StackPanel>
                            </GroupBox>
                        </Grid>
                        <TextBlock Foreground="{DynamicResource OtherDimBrush}" TextWrapping="Wrap"
                                   Text="Shift+1～5 でモードを切り替えます。設定はモードごとに保存されます。"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ================= 操作 ================= -->
            <TabItem Header="操作">
                <StackPanel Margin="8">
                    <GroupBox Header="E: 編集 で使うエディタ">
                        <StackPanel>
                            <TextBox x:Name="EditorBox" Margin="0,0,0,4"/>
                            <TextBlock Foreground="{DynamicResource OtherDimBrush}" TextWrapping="Wrap"
                                       Text="例: notepad.exe / code / C:\Program Files\sakura\sakura.exe"/>
                            <DockPanel Margin="0,8,0,2">
                                <TextBlock Text="行指定の引数:" Foreground="{DynamicResource InfoItemBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="EditorLineBox"/>
                            </DockPanel>
                            <TextBlock Foreground="{DynamicResource OtherDimBrush}" TextWrapping="Wrap"
                                       Text="文字列の検索（Shift+F）の結果から E で開くときに使います。$F = ファイル、$L = 行番号。例: VS Code → -g &quot;$F:$L&quot;　サクラ → -Y=$L &quot;$F&quot;　秀丸 → /j$L &quot;$F&quot;　空欄なら行指定なしで開きます。"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Shift+W: 比較 で使うツール（WinMerge など）">
                        <StackPanel>
                            <TextBox x:Name="DiffToolBox" Margin="0,0,0,4"/>
                            <TextBlock Foreground="{DynamicResource OtherDimBrush}" TextWrapping="Wrap"
                                       Text="空欄なら PATH と C:\Program Files\WinMerge\WinMergeU.exe を探します。引数は「左 右」の順で渡し、フォルダ比較には /r を付けます。$L = 左、$R = 右 を書けば引数の形を変えられます（例: &quot;C:\Tools\BCompare.exe&quot; $L $R）。"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="ファイル操作">
                        <StackPanel>
                            <CheckBox x:Name="RecycleCheck" Content="D: 削除 はごみ箱へ移動する（Shift+D で完全削除）"/>
                            <CheckBox x:Name="HiddenCheck" Content="隠しファイルを表示する（Shift+D でも切替）"/>
                            <CheckBox x:Name="IconCheck" Content="ファイル一覧・ツリーにアイコンを表示する（Ctrl+I でも切替）"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="隠し属性のフォルダ / ファイルの並び">
                        <StackPanel>
                            <RadioButton x:Name="GroupFirst" Content="隠しを先にまとめる（WinFM2008 と同じ）"/>
                            <RadioButton x:Name="GroupLast"  Content="隠しを後にまとめる"/>
                            <RadioButton x:Name="GroupMixed" Content="分けずに名前順などで混在"/>
                            <TextBlock Foreground="{DynamicResource OtherDimBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="フォルダとファイルそれぞれの中で、隠し属性（システム属性含む）のものをグループ分けします。"/>
                        </StackPanel>
                    </GroupBox>
                    <TextBlock Foreground="{DynamicResource OtherDimBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="設定ファイル: %APPDATA%\FDLike2026\settings.json　　ジャンプ先の登録は J キーの JumpFolder から行います。"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
