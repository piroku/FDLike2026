<Window x:Class="FDLike2026.Views.MacroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Macro - コマンドマクロ" Width="960" Height="640" MinWidth="640" MinHeight="400"
        TextOptions.TextFormattingMode="{DynamicResource TextFormattingMode}"
        TextOptions.TextRenderingMode="{DynamicResource TextRenderingMode}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource OtherBgBrush}" FontFamily="{DynamicResource OtherFontFamily}" FontSize="{DynamicResource OtherFontSize}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Row" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelBgBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelFgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="4">
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Frame}">
            <TextBlock Style="{StaticResource Mono}" Foreground="{DynamicResource OtherDimBrush}" TextWrapping="Wrap"
                       Text="A～Z / 1～9 キー / クリック / Enter: 実行　　Ins / Space / 右クリック: マクロの設定　　Del: 削除　　Esc: 閉じる&#x0a;$P パス  $D ドライブ  $C ファイル  $X 拡張子なし  $T タグ列  $F フルパス列  $O 反対ペインのパス  $OC 反対ペインのファイル  $Q &quot;  $Z ,  $R 入力  $YY $YM $YD $Yh $Ym $Ys 日時  $SN 件数  $Ss サイズ  ; で複数コマンド  例: 秀丸,&quot;C:\Program Files\Hidemaru\Hidemaru.exe&quot; $Q$P\$C$Q"/>
        </Border>
        <Border Style="{StaticResource Frame}">
            <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Focusable="False" Foreground="{DynamicResource OtherFgBrush}"
                     ItemContainerStyle="{StaticResource Row}" KeyboardNavigation.DirectionalNavigation="None"
                     PreviewMouseLeftButtonUp="List_MouseLeftUp" PreviewMouseRightButtonDown="List_MouseRightDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="実行(_R)" Click="Menu_Run"/>
                        <Separator/>
                        <MenuItem Header="設定(_E)　Ins" Click="Menu_Edit"/>
                        <MenuItem Header="削除(_D)　Del" Click="Menu_Delete"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock TextAlignment="Right" VerticalAlignment="Center"><Run Text="{Binding Key, Mode=OneWay}"/><Run Text=" :"/></TextBlock>
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Title, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Command, Mode=OneWay}" TextTrimming="CharacterEllipsis" Opacity="0.85"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
