<Window x:Class="FDLike2026.Views.AttributeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="属性変更" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        TextOptions.TextFormattingMode="{DynamicResource TextFormattingMode}"
        TextOptions.TextRenderingMode="{DynamicResource TextRenderingMode}"
        RenderOptions.ClearTypeHint="Enabled"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource BaseFontSize}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="IsThreeState" Value="True"/>
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource Frame}" Margin="8">
        <StackPanel Margin="8">
            <TextBlock x:Name="PromptText" Style="{StaticResource Label}" Margin="0,0,0,8"/>
            <CheckBox x:Name="ChkR" Content="R: 読み取り専用 (ReadOnly)"/>
            <CheckBox x:Name="ChkH" Content="H: 隠しファイル (Hidden)"/>
            <CheckBox x:Name="ChkS" Content="S: システム (System)"/>
            <CheckBox x:Name="ChkA" Content="A: アーカイブ (Archive)"/>
            <TextBlock Style="{StaticResource Mono}" Foreground="{DynamicResource DimBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="R/H/S/A キーで切替　□=解除 ■=設定 ▣=変更しない　Enter: 決定　Esc: 取消"/>
        </StackPanel>
    </Border>
</Window>
