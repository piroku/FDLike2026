<Window x:Class="FDLike2026.Views.ExecDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="コマンドの実行" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        TextOptions.TextFormattingMode="{DynamicResource TextFormattingMode}"
        TextOptions.TextRenderingMode="{DynamicResource TextRenderingMode}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource OtherBgBrush}" FontFamily="{DynamicResource OtherFontFamily}" FontSize="{DynamicResource OtherFontSize}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InfoItemBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource InfoItemBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource Frame}" Margin="8">
        <StackPanel Margin="10">
            <DockPanel Margin="0,0,0,4">
                <Label Content="アプリケーション名(_N):" DockPanel.Dock="Left" Target="{Binding ElementName=AppBox}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox x:Name="NoPauseCheck" Content="終了後に一時停止しない(_R)"/>
                    <CheckBox x:Name="DosCheck" Content="DOSコマンド(_D)" IsChecked="True" Margin="0"/>
                </StackPanel>
            </DockPanel>
            <ComboBox x:Name="AppBox" IsEditable="True" Foreground="Black" Margin="0,0,0,8" KeyDown="Box_KeyDown"/>
            <CheckBox x:Name="RunAsCheck" Content="別のユーザーとして実行(_U)（管理者として実行）" HorizontalAlignment="Right" Margin="0,0,0,8"/>
            <Label Content="コマンドライン(_C):" Margin="0,0,0,4" Target="{Binding ElementName=ArgBox}"/>
            <ComboBox x:Name="ArgBox" IsEditable="True" Foreground="Black" Margin="0,0,0,10" KeyDown="Box_KeyDown"/>
            <TextBlock Foreground="{DynamicResource OtherDimBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="$ または ; を含む場合はマクロとして展開します（$P パス $C ファイル $X 拡張子なし $T タグ列 $Q &quot; $R 入力）。「DOSコマンド」ON で cmd 経由で実行し、終了後に一時停止します。"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Click="Ok_Click" IsDefault="True"/>
                <Button Content="キャンセル" Click="Cancel_Click" IsCancel="True" Margin="0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
