<Window x:Class="FDLike2026.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FDLike2026" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        TextOptions.TextFormattingMode="{DynamicResource TextFormattingMode}"
        TextOptions.TextRenderingMode="{DynamicResource TextRenderingMode}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource OtherBgBrush}" FontFamily="{DynamicResource OtherFontFamily}" FontSize="{DynamicResource OtherFontSize}"
        Closing="Window_Closing">
    <Border Style="{StaticResource Frame}" Margin="8">
        <StackPanel Margin="10">
            <TextBlock x:Name="Caption" Style="{StaticResource Label}" Margin="0,0,0,8"/>
            <TextBlock x:Name="Detail" Style="{StaticResource Mono}" Foreground="{DynamicResource OtherDimBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
            <ProgressBar x:Name="Bar" Height="18" Minimum="0" Maximum="100" Margin="0,0,0,8"
                         Foreground="{DynamicResource InfoTimeBrush}" Background="#40000000" BorderBrush="{DynamicResource FrameBrush}"/>
            <DockPanel>
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="中止 (Esc)" Padding="12,3" Click="Cancel_Click"
                        Background="#40000000" Foreground="{DynamicResource OtherFgBrush}" BorderBrush="{DynamicResource FrameBrush}"/>
                <TextBlock x:Name="CountText" Style="{StaticResource Mono}"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
