<Window x:Class="FDLike2026.Views.ArchiveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ファイルの圧縮" Width="680" SizeToContent="Height" ResizeMode="NoResize"
        TextOptions.TextFormattingMode="{DynamicResource TextFormattingMode}"
        TextOptions.TextRenderingMode="{DynamicResource TextRenderingMode}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource OtherBgBrush}" FontFamily="{DynamicResource OtherFontFamily}" FontSize="{DynamicResource OtherFontSize}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InfoItemBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource InfoItemBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource Frame}" Margin="8">
        <StackPanel Margin="10">
            <TextBlock x:Name="TargetText" Foreground="{DynamicResource OtherFgBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <!-- 圧縮時のみ -->
            <StackPanel x:Name="PackPanel">
                <Label Content="圧縮ファイル名(_A):" Margin="0,0,0,4" Target="{Binding ElementName=ZipNameBox}"/>
                <TextBox x:Name="ZipNameBox" Margin="0,0,0,10"/>
            </StackPanel>

            <DockPanel Margin="0,0,0,4">
                <Label x:Name="FolderLabel" Content="書庫を作成するフォルダ(_F):" DockPanel.Dock="Left" Target="{Binding ElementName=FolderBox}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="ジャンプ(_J)..." Click="Jump_Click"/>
                    <Button Content="カレント(_U)" Click="Current_Click"/>
                    <Button Content="反対側(_O)" Click="Other_Click"/>
                    <Button Content="参照(_R)..." Click="Browse_Click" Margin="0"/>
                </StackPanel>
            </DockPanel>
            <TextBox x:Name="FolderBox" Margin="0,0,0,10"/>

            <GroupBox Header="オプション" Foreground="{DynamicResource InfoTitleBrush}" BorderBrush="{DynamicResource FrameBrush}" Padding="8,4">
                <StackPanel>
                    <StackPanel x:Name="PackOptions">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="圧縮レベル: " DockPanel.Dock="Left"/>
                            <ComboBox x:Name="LevelCombo" Width="200" HorizontalAlignment="Left" Foreground="Black" SelectedIndex="0">
                                <ComboBoxItem Content="標準"/>
                                <ComboBoxItem Content="最速"/>
                                <ComboBoxItem Content="最高（小さく・遅い）"/>
                                <ComboBoxItem Content="無圧縮（格納のみ）"/>
                            </ComboBox>
                        </DockPanel>
                        <CheckBox x:Name="EachCheck" Content="オブジェクト単位で書庫化する（選択したファイル / フォルダごとに別の zip を作る）"/>
                    </StackPanel>
                    <StackPanel x:Name="UnpackOptions">
                        <CheckBox x:Name="SubdirCheck" Content="書庫名のフォルダを作ってその中に展開する" IsChecked="True"/>
                        <CheckBox x:Name="OverwriteCheck" Content="既存のファイルを上書きする" IsChecked="False"/>
                    </StackPanel>
                    <CheckBox x:Name="GoCheck" Content="終了後、作成先 / 解凍先のフォルダへ移動する" IsChecked="True"/>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="OkButton" Content="開始 (Enter)" Click="Ok_Click" IsDefault="True"/>
                <Button Content="キャンセル (Esc)" Click="Cancel_Click" IsCancel="True" Margin="0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
