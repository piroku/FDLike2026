<Window x:Class="FDLike2026.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FDLike2026" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        TextOptions.TextFormattingMode="{DynamicResource TextFormattingMode}"
        TextOptions.TextRenderingMode="{DynamicResource TextRenderingMode}"
        RenderOptions.ClearTypeHint="Enabled"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource BaseFontSize}">
    <Border Style="{StaticResource Frame}" Margin="8">
        <StackPanel Margin="8">
            <TextBlock x:Name="PromptText" Style="{StaticResource Label}" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <TextBox x:Name="Input" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource BaseFontSize}"
                     Background="#FF000040" Foreground="White" CaretBrush="White" BorderBrush="{DynamicResource FrameBrush}"
                     Padding="4,2" KeyDown="Input_KeyDown"/>
            <TextBlock Style="{StaticResource Mono}" Foreground="{DynamicResource DimBrush}" Margin="0,8,0,0"
                       Text="Enter: 決定　　Esc: 取消"/>
        </StackPanel>
    </Border>
</Window>
