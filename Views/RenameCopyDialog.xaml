<Window x:Class="FDLike2026.Views.RenameCopyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="名前の変更" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        TextOptions.TextFormattingMode="{DynamicResource TextFormattingMode}"
        TextOptions.TextRenderingMode="{DynamicResource TextRenderingMode}"
        RenderOptions.ClearTypeHint="Enabled"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource OtherBgBrush}" FontFamily="{DynamicResource OtherFontFamily}" FontSize="{DynamicResource OtherFontSize}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource Frame}" Margin="8">
        <StackPanel Margin="12,10">
            <TextBlock x:Name="Lead" Foreground="{DynamicResource InfoTitleBrush}" Margin="0,0,0,8"
                       Text="同じフォルダへ複写します。新しい名前を付けてください。"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="名前: " Foreground="{DynamicResource InfoItemBrush}"/>
                <TextBlock Grid.Column="1" x:Name="NameText"/>
                <TextBlock Grid.Row="1" Text="場所: " Foreground="{DynamicResource InfoItemBrush}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PlaceText" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="2" Text="種類: " Foreground="{DynamicResource InfoItemBrush}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="KindText"/>
            </Grid>
            <Label Content="新しい名前を入力してください(_N):" Target="{Binding ElementName=NewName}" Foreground="{DynamicResource OtherFgBrush}" Padding="0" Margin="0,0,0,4"/>
            <TextBox x:Name="NewName" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK(_Y)" Click="Ok_Click" IsDefault="True"/>
                <Button Content="スキップ(_S)" Click="Skip_Click"/>
                <Button Content="キャンセル(_C)" Click="Cancel_Click" IsCancel="True" Margin="0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
