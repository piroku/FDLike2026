<Window x:Class="FDLike2026.Views.GrepWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文字列の検索 (grep)" Width="1000" Height="680" MinWidth="720" MinHeight="460"
        TextOptions.TextFormattingMode="{DynamicResource TextFormattingMode}"
        TextOptions.TextRenderingMode="{DynamicResource TextRenderingMode}"
        RenderOptions.ClearTypeHint="Enabled"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource OtherBgBrush}" FontFamily="{DynamicResource OtherFontFamily}" FontSize="{DynamicResource OtherFontSize}"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="96"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InfoItemBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource InfoBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InfoTitleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 検索文字列 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="検索文字列(N):" DockPanel.Dock="Left" Margin="0,0,12,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox x:Name="RegexCheck" Content="正規表現(_E)"/>
                <CheckBox x:Name="CaseCheck" Content="大文字小文字を区別(_A)"/>
                <CheckBox x:Name="WordCheck" Content="単語単位(_W)" Margin="0"/>
            </StackPanel>
        </DockPanel>
        <ComboBox Grid.Row="1" x:Name="TextBox1" IsEditable="True" Margin="0,0,0,8" KeyDown="TextBox1_KeyDown"/>

        <!-- 対象ファイル -->
        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="対象ファイル(T):" DockPanel.Dock="Left" Margin="0,0,12,0"/>
            <Button DockPanel.Dock="Right" Content="全部(_Z)" Click="AllFiles_Click" Margin="8,0,0,0" MinWidth="70"/>
            <TextBox x:Name="MaskBox" ToolTip="ワイルドカード、スペース区切りで複数。空欄なら全ファイル（バイナリは自動で除外）"/>
        </DockPanel>

        <!-- 探す場所 -->
        <DockPanel Grid.Row="3" Margin="0,0,0,4">
            <TextBlock Text="探す場所(L):" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="ジャンプ(_J)..." Click="Jump_Click"/>
                <Button Content="カレント(_U)" Click="Current_Click"/>
                <Button Content="ドライブ全体(_Y)" Click="Root_Click"/>
                <Button Content="参照(_R)..." Click="Browse_Click" Margin="0"/>
            </StackPanel>
        </DockPanel>
        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBox x:Name="PathBox" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="SubCheck" Content="サブフォルダも探す(_S)" IsChecked="True"/>
                <CheckBox x:Name="HiddenCheck" Content="隠しファイルも探す(_H)" IsChecked="False"/>
                <CheckBox x:Name="DocCheck" Content="Office / PDF の中身も(_O)" IsChecked="True"
                          ToolTip="対象ファイルのマスクに関係なく、Word / Excel / PowerPoint / PDF（と Office が入っていれば .doc / .xls / .ppt など旧形式も）の中の文字を探します。画像だけの PDF は対象外です。"/>
                <TextBlock Text="上限サイズ:" Margin="8,0,4,0"/>
                <TextBox x:Name="MaxMbBox" Width="44" TextAlignment="Right" Text="20"/>
                <TextBlock Text=" MB" Foreground="{DynamicResource OtherFgBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- 進捗 -->
        <DockPanel Grid.Row="5" Margin="0,0,0,8">
            <TextBlock Text="検索中のフォルダ(D):" DockPanel.Dock="Left" Margin="0,0,8,0"/>
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{DynamicResource InfoDataBrush}" Margin="12,0,0,0" Text=""/>
            <TextBlock x:Name="ScanText" Foreground="{DynamicResource OtherDimBrush}" TextTrimming="CharacterEllipsis" Text=""/>
        </DockPanel>

        <!-- 結果 -->
        <DockPanel Grid.Row="6">
            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4"
                       Text="見つかった行(F):　　Enter/M: そのファイルへ移動　V: ビューアで該当行　E: エディタで該当行　T: ヒットした全ファイルにタグ　Ctrl+C: 一覧をコピー"/>
            <ListView x:Name="Results" Background="#40000000" BorderBrush="{DynamicResource FrameBrush}"
                      Foreground="{DynamicResource OtherFgBrush}"
                      MouseDoubleClick="Results_DoubleClick" SelectionChanged="Results_SelectionChanged"
                      ItemContainerStyle="{StaticResource FdListViewItem}"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource SelBgColor}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource SelFgColor}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource SelBgColor}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource SelFgColor}"/>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}"/>
                    </Style>
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名前" Width="220" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="フォルダ名" Width="260" DisplayMemberBinding="{Binding Folder}"/>
                        <GridViewColumn Header="行" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Line}" TextAlignment="Right"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="内容" Width="900">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- 一致部分を黄色で強調（Pre / Hit / Post に分けてある） -->
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Pre, Mode=OneWay}"/><Run Text="{Binding Hit, Mode=OneWay}" FontWeight="Bold" Background="#60FF0000" TextDecorations="Underline"/><Run Text="{Binding Post, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>

        <!-- ボタン -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="StartButton" Content="検索開始(_I)" Click="Start_Click" IsDefault="True"/>
            <Button x:Name="StopButton"  Content="終了(_X)" Click="Stop_Click" IsEnabled="False"/>
            <Button x:Name="GoButton"    Content="移動(_M)" Click="Go_Click" IsEnabled="False"/>
            <Button x:Name="ViewButton"  Content="ビューア(_V)" Click="View_Click" IsEnabled="False"/>
            <Button x:Name="EditButton"  Content="エディタ(_E)" Click="Edit_Click" IsEnabled="False"/>
            <Button x:Name="TagButton"   Content="タグ付け(_T)" Click="Tag_Click" IsEnabled="False"/>
            <Button x:Name="CopyButton"  Content="コピー(_P)" Click="Copy_Click" IsEnabled="False" ToolTip="結果の一覧をテキスト（パス｜行｜内容、タブ区切り）としてクリップボードへ。行を複数選択していればその行だけ。Ctrl+C でも"/>
            <Button Content="閉じる(_C)" Click="Close_Click" IsCancel="True" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
