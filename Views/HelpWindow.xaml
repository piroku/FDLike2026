<Window x:Class="FDLike2026.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FDLike2026 - キー操作" Width="980" Height="760" MinWidth="640" MinHeight="400"
        TextOptions.TextFormattingMode="{DynamicResource TextFormattingMode}"
        TextOptions.TextRenderingMode="{DynamicResource TextRenderingMode}"
        RenderOptions.ClearTypeHint="Enabled"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource OtherBgBrush}" FontFamily="{DynamicResource OtherFontFamily}" FontSize="{DynamicResource OtherFontSize}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <!-- 左のカテゴリ: 選択は黄色帯 -->
        <Style x:Key="CatItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelBgBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelFgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="閉じる (Esc)" Click="Close_Click" IsCancel="True"/>
            <TextBlock DockPanel.Dock="Left" Text="絞り込み: " Foreground="{DynamicResource InfoItemBrush}" VerticalAlignment="Center"/>
            <TextBox x:Name="FilterBox" TextChanged="Filter_Changed" Margin="4,0,8,0"
                     Background="#40000000" Foreground="{DynamicResource OtherFgBrush}" CaretBrush="{DynamicResource OtherFgBrush}"
                     BorderBrush="{DynamicResource FrameBrush}" Padding="4,2" VerticalAlignment="Center"/>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Frame}" Margin="0">
                <ListBox x:Name="CatList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource OtherFgBrush}"
                         ItemContainerStyle="{StaticResource CatItem}" SelectionChanged="Cat_Changed" DisplayMemberPath="Title"/>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Frame}" Margin="0">
                <DockPanel>
                    <TextBlock x:Name="SectionTitle" DockPanel.Dock="Top" Foreground="{DynamicResource InfoTitleBrush}" FontSize="{DynamicResource HeaderFontSize}" Margin="8,4,8,2"/>
                    <TextBlock x:Name="SectionNote" DockPanel.Dock="Top" Foreground="{DynamicResource OtherDimBrush}" TextWrapping="Wrap" Margin="8,0,8,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Rows" Margin="4,0,8,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#30FFFFFF" BorderThickness="0,0,0,1" Padding="4,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="230"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" Foreground="{DynamicResource InfoItemBrush}" FontWeight="Bold" VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Desc}" Foreground="{DynamicResource OtherFgBrush}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
