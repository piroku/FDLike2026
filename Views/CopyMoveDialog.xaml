<Window x:Class="FDLike2026.Views.CopyMoveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ファイルの複写" Width="720" SizeToContent="Height" ResizeMode="NoResize"
        TextOptions.TextFormattingMode="{DynamicResource TextFormattingMode}"
        TextOptions.TextRenderingMode="{DynamicResource TextRenderingMode}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource OtherBgBrush}" FontFamily="{DynamicResource OtherFontFamily}" FontSize="{DynamicResource OtherFontSize}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource OtherFgBrush}"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InfoItemBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource InfoTitleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource InfoItemBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource Frame}" Margin="8">
        <StackPanel Margin="10">
            <TextBlock x:Name="TargetText" Foreground="{DynamicResource OtherFgBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <DockPanel Margin="0,0,0,4">
                <Label x:Name="DestLabel" Content="複写先フォルダ(_D):" DockPanel.Dock="Left" Target="{Binding ElementName=DestBox}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="ジャンプ(_J)..." Click="Jump_Click"/>
                    <Button Content="反対側(_O)" Click="Other_Click"/>
                    <Button Content="カレント(_U)" Click="Current_Click"/>
                    <Button Content="参照(_R)..." Click="Browse_Click" Margin="0"/>
                </StackPanel>
            </DockPanel>
            <ComboBox x:Name="DestBox" IsEditable="True" Foreground="Black" Margin="0,0,0,10"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <GroupBox Grid.Column="0" Header="フィルタ（フォルダを複写するとき）">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="検索対象:" Margin="0,0,8,4"/>
                        <TextBox Grid.Column="1" x:Name="IncludeBox" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="1" Text="除外:" Margin="0,0,8,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="ExcludeBox"/>
                    </Grid>
                </GroupBox>
                <GroupBox Grid.Column="2" Header="同名ファイルがあるとき">
                    <StackPanel>
                        <RadioButton x:Name="OwAsk" Content="その都度確認する" IsChecked="True"/>
                        <RadioButton x:Name="OwNewer" Content="タイムスタンプが新しい時だけ上書き"/>
                        <RadioButton x:Name="OwOverwrite" Content="常に上書き"/>
                        <RadioButton x:Name="OwRename" Content="名前を変えて複写（自動で (2) など）"/>
                        <RadioButton x:Name="OwSkip" Content="複写しない"/>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <GroupBox Header="オプション">
                <StackPanel>
                    <CheckBox x:Name="UpdateCheck" Content="既存のファイルのみ（アップデート）"/>
                    <CheckBox x:Name="ReadOnlyCheck" Content="書き込み禁止属性を外して複写（移動）"/>
                    <CheckBox x:Name="StructureCheck" Content="フォルダ構造のみをコピー"/>
                    <CheckBox x:Name="GoCheck" Content="終了後、複写（移動）先フォルダへ移動する"/>
                    <DockPanel x:Name="RenamePanel" Margin="0,3">
                        <CheckBox x:Name="RenameCheck" Content="名前を変えて複写:" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                        <TextBox x:Name="RenameBox" IsEnabled="{Binding IsChecked, ElementName=RenameCheck}"/>
                    </DockPanel>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button x:Name="OkButton" Content="開始 (Enter)" Click="Ok_Click" IsDefault="True"/>
                <Button Content="キャンセル (Esc)" Click="Cancel_Click" IsCancel="True" Margin="0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
