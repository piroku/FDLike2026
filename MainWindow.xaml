<Window x:Class="FDLike2026.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FDLike2026"
        xmlns:vm="clr-namespace:FDLike2026.ViewModels"
        xmlns:m="clr-namespace:FDLike2026.Models"
        Title="FDLike2026"
        Icon="pack://application:,,,/app.ico" Width="1440" Height="860" MinWidth="900" MinHeight="500"
        TextOptions.TextFormattingMode="{DynamicResource TextFormattingMode}"
        TextOptions.TextRenderingMode="{DynamicResource TextRenderingMode}"
        RenderOptions.ClearTypeHint="Enabled"
        Background="{DynamicResource OtherBgBrush}"
        FontFamily="{DynamicResource OtherFontFamily}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded" Closing="Window_Closing" Activated="Window_Activated">

    <Window.Resources>
        <local:KiloConverter x:Key="Kilo"/>
        <local:CommaConverter x:Key="Comma"/>
        <local:BoolToVisibilityConverter x:Key="Vis"/>
        <local:BoolToVisibilityConverter x:Key="VisInv" Invert="True"/>
        <local:SortNameConverter x:Key="SortName"/>

        <Style x:Key="TreeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource TreeFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource TreeFontSize}"/>
            <Setter Property="FontWeight" Value="{DynamicResource TreeFontWeight}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TreeItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Foreground" Value="{DynamicResource TreeFgBrush}"/>
            <Setter Property="Padding" Value="{DynamicResource TreeRowPadding}"/>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource TreeSelBgColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource TreeSelBgColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource TreeSelFgColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource TreeSelFgColor}"/>
            </Style.Resources>
        </Style>

        <!-- 情報ボックス用: App の Mono / Label を情報ボックスのフォント・色で上書き（この Window 内だけ有効） -->
        <Style TargetType="TextBlock" x:Key="Mono">
            <Setter Property="FontFamily" Value="{DynamicResource InfoFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource InfoFontSize}"/>
            <Setter Property="FontWeight" Value="{DynamicResource InfoFontWeight}"/>
            <Setter Property="Foreground" Value="{DynamicResource InfoDataBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}" x:Key="Label">
            <Setter Property="Foreground" Value="{DynamicResource InfoItemBrush}"/>
        </Style>

        <!-- ファイル一覧 1 行: 一般のファイル色（拡張子・サイズ・日付）。属性ごとの色は後の Trigger ほど優先 -->
        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource ListFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource ListFontSize}"/>
            <Setter Property="FontWeight" Value="{DynamicResource ListFontWeight}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource FileBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompressed}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource CompFileBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ReadOnlyBrush}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsReadOnly}" Value="True"/>
                        <Condition Binding="{Binding IsCompressed}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource CompReadOnlyBrush}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsReparse}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ReparseBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEncrypted}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource EncFileBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DirBrush}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDirectory}" Value="True"/>
                        <Condition Binding="{Binding IsCompressed}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource CompDirBrush}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDirectory}" Value="True"/>
                        <Condition Binding="{Binding IsEncrypted}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource EncDirBrush}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource HiddenBrush}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsHidden}" Value="True"/>
                        <Condition Binding="{Binding IsCompressed}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource CompHiddenBrush}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tagged}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TagBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCursor}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource CursorFgBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 名前列だけは「一般のファイル：名前」色を既定にする（WinFM は名前が白、数値が黄） -->
        <!-- 名前列: WinFM2008 と同じく「一般のファイル」の色（既定は黄）。属性付きは RowText のトリガーが上書き -->
        <Style x:Key="RowName" TargetType="TextBlock" BasedOn="{StaticResource RowText}">
            <Setter Property="Foreground" Value="{DynamicResource FileBrush}"/>
        </Style>
        <Style x:Key="RowNumber" TargetType="TextBlock" BasedOn="{StaticResource RowText}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <!-- git の状態列: 名前の色は属性のまま、この列だけ git の色（VS Code と同じ配色が既定） -->
        <Style x:Key="RowGit" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource ListFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource ListFontSize}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding GitKey}" Value="Modified"><Setter Property="Foreground" Value="{DynamicResource GitModifiedBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding GitKey}" Value="Untracked"><Setter Property="Foreground" Value="{DynamicResource GitUntrackedBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding GitKey}" Value="Added"><Setter Property="Foreground" Value="{DynamicResource GitAddedBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding GitKey}" Value="Deleted"><Setter Property="Foreground" Value="{DynamicResource GitDeletedBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding GitKey}" Value="Ignored"><Setter Property="Foreground" Value="{DynamicResource GitIgnoredBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="RowTemplate" DataType="{x:Type m:FileEntry}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- 幅は文字数ベース（ThemeService がフォントから計算） -->
                    <ColumnDefinition Width="{DynamicResource ListColTag}"/>
                    <ColumnDefinition Width="{DynamicResource ListColIcon}"/>
                    <ColumnDefinition Width="{Binding NameColWidth}"/>
                    <ColumnDefinition Width="{Binding ExtColWidth}"/>
                    <ColumnDefinition Width="{DynamicResource ListColSize}"/>
                    <ColumnDefinition Width="{DynamicResource ListColDate}"/>
                    <ColumnDefinition Width="{DynamicResource ListColTime}"/>
                    <ColumnDefinition Width="{DynamicResource ListColAttr}"/>
                    <ColumnDefinition Width="{DynamicResource ListColGit}"/>
                    <ColumnDefinition Width="{DynamicResource ListColFill}"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource RowText}" Text="{DynamicResource TagMarkText}" Visibility="{Binding Tagged, Converter={StaticResource Vis}}"/>
                <Image Grid.Column="1" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"
                       Visibility="{DynamicResource IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Grid.Column="2" Style="{StaticResource RowName}" Text="{Binding BaseName}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3" Style="{StaticResource RowText}" Text="{Binding Extension}"/>
                <TextBlock Grid.Column="4" Style="{StaticResource RowNumber}" Text="{Binding SizeText}" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="5" Style="{StaticResource RowNumber}" Text="{Binding DateText}"/>
                <TextBlock Grid.Column="6" Style="{StaticResource RowNumber}" Text="{Binding TimeText}"/>
                <TextBlock Grid.Column="7" Style="{StaticResource RowText}" Text="{Binding AttrText}" Margin="8,0,0,0"/>
                <TextBlock Grid.Column="8" Style="{StaticResource RowGit}" Text="{Binding GitText}" Margin="4,0,0,0" HorizontalAlignment="Left"/>
            </Grid>
        </DataTemplate>

        <!-- ファイル一覧の右クリックメニュー（キー操作と同じコマンドを呼ぶ） -->
        <ContextMenu x:Key="ListMenu" Opened="ListMenu_Opened">
            <MenuItem Name="MenuOpen"   Header="開く / 実行(_O)　　Enter / R" Click="Menu_Open"/>
            <MenuItem Name="MenuEdit"   Header="編集(_E)　　E" Click="Menu_Edit"/>
            <MenuItem Name="MenuView"   Header="ビューア(_V)　　V" Click="Menu_View"/>
            <Separator/>
            <MenuItem Name="MenuCopy"   Header="複写 → 反対側へ(_C)　　C" Click="Menu_Copy"/>
            <MenuItem Name="MenuMove"   Header="移動 → 反対側へ(_M)　　M" Click="Menu_Move"/>
            <MenuItem Name="MenuRename" Header="名前の変更(_N)　　N" Click="Menu_Rename"/>
            <MenuItem Name="MenuRenameSeq" Header="名前の一括変換（連番）　　Shift+N" Click="Menu_RenameSeq"/>
            <MenuItem Name="MenuDelete" Header="削除（ごみ箱）(_D)　　D" Click="Menu_Delete"/>
            <MenuItem Name="MenuDelPerm" Header="完全に削除　　Shift+D" Click="Menu_DeletePermanent"/>
            <MenuItem Name="MenuAttr"   Header="属性の変更(_A)　　A" Click="Menu_Attr"/>
            <MenuItem Name="MenuPack"   Header="zip に圧縮(_Z)　　P" Click="Menu_Pack"/>
            <MenuItem Name="MenuUnpack" Header="zip を解凍(_U)　　U" Click="Menu_Unpack"/>
            <Separator/>
            <MenuItem Header="新規フォルダの作成(_K)　　K" Click="Menu_Mkdir"/>
            <MenuItem Name="MenuExplorer" Header="エクスプローラーで開く(_X)　　Z" Click="Menu_Explorer"/>
            <MenuItem Header="ここで PowerShell を開く(_P)　　B" Click="Menu_PowerShell"/>
            <MenuItem Header="ファイルの検索(_F)　　F" Click="Menu_Find"/>
            <MenuItem Header="文字列の検索 (grep)(_G)　　Shift+F" Click="Menu_Grep"/>
            <MenuItem Header="ミラーコピー　　Ctrl+M" Click="Menu_Mirror"/>
            <Separator/>
            <MenuItem Name="MenuClip" Header="コピー（クリップボード）　　Ctrl+C" Click="Menu_Clip"/>
            <MenuItem Name="MenuCut" Header="切り取り　　Ctrl+X" Click="Menu_Cut"/>
            <MenuItem Header="貼り付け　　Ctrl+V" Click="Menu_Paste"/>
            <MenuItem Name="MenuCopyPath" Header="フルパスをコピー　　Ctrl+B" Click="Menu_CopyPath"/>
            <MenuItem Name="MenuCopyName" Header="ファイル名をコピー　　Ctrl+Shift+B" Click="Menu_CopyName"/>
            <MenuItem Name="MenuProps" Header="プロパティ　　Shift+P" Click="Menu_Props"/>
            <MenuItem Header="再読込(_R)　　F5" Click="Menu_Refresh"/>
            <Separator/>
            <MenuItem Name="MenuShell" Header="Windows のメニュー(_W)..." Click="Menu_ShellMenu"/>
            <Separator/>
            <MenuItem Name="MenuRightPane" Header="右ウィンドウを表示(_W)　　Shift+F6" IsCheckable="True" Click="Menu_RightPane"/>
            <MenuItem Header="ツリーを表示(_T)　　F6" Click="Menu_Tree"/>
        </ContextMenu>

        <!-- 行コンテナ: 標準の選択色を消し、カーソル行だけ背景を付ける -->
        <Style x:Key="RowContainer" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="{DynamicResource ListRowPadding}"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsCursor}" Value="True"/>
                                    <Condition Binding="{Binding DataContext.IsActive, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CursorBrush}"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsCursor}" Value="True"/>
                                    <Condition Binding="{Binding DataContext.IsActive, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InactiveCursorBrush}"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaneList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="None"/>
            <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
            <Setter Property="ItemTemplate" Value="{StaticResource RowTemplate}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource RowContainer}"/>
            <Setter Property="ItemsSource" Value="{Binding Entries}"/>
            <Setter Property="SelectedIndex" Value="{Binding CursorIndex, Mode=TwoWay}"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <!-- Recycling だと使い回されたコンテナにカーソル背景が残ることがあるため Standard -->
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ContextMenu" Value="{StaticResource ListMenu}"/>
        </Style>

        <!-- ペイン枠: アクティブ側は明るい枠 -->
        <Style x:Key="PaneFrame" TargetType="Border" BasedOn="{StaticResource Frame}">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource ListBgBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource InfoDataBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ツリー -->
        <HierarchicalDataTemplate x:Key="TreeTemplate" DataType="{x:Type vm:TreeNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"
                       Visibility="{DynamicResource IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Style="{StaticResource TreeText}" Text="{Binding IsDrive, Converter={x:Static local:DriveIconConverter.Instance}}" Foreground="{DynamicResource TreeButtonBrush}" Margin="0,0,4,0"
                           Visibility="{DynamicResource IconOffVisibility}"/>
                <TextBlock Style="{StaticResource TreeText}" Text="{Binding Name}"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1 行目: キーガイド + 時計 + タイトル -->
        <Grid Grid.Row="0" Margin="4,2" Background="{DynamicResource FuncBgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ItemsControl Grid.Column="0" ItemsSource="{Binding KeyGuide}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource Mono}" Margin="0,0,18,0" FontSize="{DynamicResource HeaderFontSize}">
                            <Run Text="{Binding Key, Mode=OneWay}" Background="{DynamicResource FuncKeyBgBrush}" Foreground="{DynamicResource FuncKeyFgBrush}"/><Run Text=":" Foreground="{DynamicResource FuncLabelBrush}"/><Run Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource FuncLabelBrush}"/>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="{DynamicResource HeaderFontSize}" Foreground="{DynamicResource InfoTimeBrush}" Text="{Binding Clock}" Margin="12,0"/>
            <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="{DynamicResource HeaderFontSize}" Foreground="{DynamicResource VersionBrush}" Text="{Binding AppTitle}" Margin="12,0,0,0"/>
        </Grid>

        <!-- 2 行目: ボリューム情報 / パス / ファイル情報 / 属性 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Frame}" Background="{DynamicResource InfoBgBrush}">
                <Grid DataContext="{Binding Active}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="{DynamicResource InfoColNum}"/>
                        <ColumnDefinition Width="{DynamicResource InfoColCount}"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource Label}" Foreground="{DynamicResource HeadingBrush}" Text="ボリューム情報" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="空き　:"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Mono}" TextAlignment="Right" Text="{Binding FreeBytes, Converter={StaticResource Kilo}}"/>
                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="カウント:"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Mono}" TextAlignment="Right" Text="{Binding ListedBytes, Converter={StaticResource Comma}}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Mono}" TextAlignment="Right">
                        <Run Text="{Binding FileCount, Mode=OneWay}"/><Run Text=" 個"/>
                    </TextBlock>
                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="タグ　:"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Mono}" TextAlignment="Right" Text="{Binding TagBytes, Converter={StaticResource Comma}}"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Mono}" TextAlignment="Right">
                        <Run Text="{Binding TagCount, Mode=OneWay}"/><Run Text=" 個"/>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Frame}" Background="{DynamicResource InfoBgBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <!-- 見出しは他のボックスと同じ 1 行目に（パスは 2 行目） -->
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Label}" Foreground="{DynamicResource HeadingBrush}" Text="ファイル情報" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="パス　:"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Active.Path}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="ファイル:"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Mono}" Foreground="{DynamicResource FileNameBrush}" Text="{Binding Active.Current.Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="日付　:"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Mono}">
                        <Run Text="{Binding Active.Current.DateFullText, Mode=OneWay}"/>
                        <Run Text="　　サイズ: " Foreground="{DynamicResource InfoItemBrush}"/><Run Text="{Binding Active.Current.SizeText, Mode=OneWay}"/>
                        <Run Text="　　時間: " Foreground="{DynamicResource InfoItemBrush}"/><Run Text="{Binding Active.Current.TimeFullText, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Frame}" Background="{DynamicResource InfoBgBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="{DynamicResource InfoColAttr}"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Label}" Foreground="{DynamicResource HeadingBrush}" Text="ファイル属性" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="マスク:"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Active.Mask}"/>
                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="属性　:"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Active.Current.AttrText}"/>
                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="ソート:"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Active.SortText}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 3 行目: ツリー + 左右ペイン -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="260"/>
                <ColumnDefinition x:Name="TreeSplitColumn" Width="6"/>
                <ColumnDefinition Width="*" MinWidth="120"/>
                <ColumnDefinition x:Name="PaneSplitColumn" Width="6"/>
                <ColumnDefinition x:Name="RightColumn" Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 境界ドラッグ: ツリー｜左一覧、左一覧｜右一覧 -->
            <GridSplitter Grid.Column="1" x:Name="TreeSplitter" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="False" DragCompleted="Splitter_DragCompleted"
                          Visibility="{Binding ShowTree, Converter={StaticResource Vis}}"/>
            <GridSplitter Grid.Column="3" x:Name="PaneSplitter" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="False" DragCompleted="Splitter_DragCompleted"/>

            <Border Grid.Column="0" x:Name="TreeFrame" Background="{DynamicResource TreeBgBrush}" Visibility="{Binding ShowTree, Converter={StaticResource Vis}}"
                    BorderThickness="1" Margin="2" Padding="4,2" BorderBrush="{DynamicResource FrameBrush}">
                <TreeView x:Name="Tree" Background="{DynamicResource TreeBgBrush}" BorderThickness="0"
                          ItemsSource="{Binding TreeRoots}"
                          ItemTemplate="{StaticResource TreeTemplate}"
                          ItemContainerStyle="{StaticResource TreeItem}"
                          SelectedItemChanged="Tree_SelectedItemChanged"
                          Focusable="False"
                          AllowDrop="True" DragOver="Tree_DragOver" Drop="Tree_Drop"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PaneFrame}" DataContext="{Binding Left}" MouseDown="Pane_MouseDown">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource RowName}" Foreground="{DynamicResource ListPathBrush}"
                               Text="{Binding Path}" TextTrimming="CharacterEllipsis" Margin="2,0,2,2"/>
                    <ListBox x:Name="LeftList" Style="{StaticResource PaneList}"
                             MouseDoubleClick="List_MouseDoubleClick"
                             PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown"
                             AllowDrop="True" DragOver="List_DragOver" Drop="List_Drop"
                             PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                             PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                             PreviewMouseMove="List_PreviewMouseMove" SizeChanged="List_SizeChanged"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="4" x:Name="RightFrame" Style="{StaticResource PaneFrame}" DataContext="{Binding Right}" MouseDown="Pane_MouseDown">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource RowName}" Foreground="{DynamicResource ListPathBrush}"
                               Text="{Binding Path}" TextTrimming="CharacterEllipsis" Margin="2,0,2,2"/>
                    <ListBox x:Name="RightList" Style="{StaticResource PaneList}"
                             MouseDoubleClick="List_MouseDoubleClick"
                             PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown"
                             AllowDrop="True" DragOver="List_DragOver" Drop="List_Drop"
                             PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                             PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                             PreviewMouseMove="List_PreviewMouseMove" SizeChanged="List_SizeChanged"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 4 行目: メッセージ行 -->
        <TextBlock Grid.Row="3" Style="{StaticResource Mono}" FontFamily="{DynamicResource OtherFontFamily}" FontSize="{DynamicResource OtherFontSize}" Foreground="{DynamicResource OtherFgBrush}" Margin="6,2"
                   Text="{Binding Message}"/>
    </Grid>
</Window>
